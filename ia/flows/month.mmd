%% Месяц пользователя Falak — от зарплаты до конца месяца.
%% Основной сценарий: экспат-кормилец, ОАЭ, зарплата к 1-му числу.
flowchart TD
    A["1-е число<br/>зарплата пришла одним платежом"] --> B{"Открывает Falak"}
    B --> C["home/payday<br/>число дня максимальное<br/>наверху: разложить сумму"]
    C --> D["Разложить:<br/>домой · аренда · накопление · на жизнь"]
    D --> E["home/base<br/>число дня пересчитано"]

    E --> F["2-е число<br/>тап по аватару матери на главном"]
    F --> G["send-home<br/>сумма, курс, придёт к 19:40<br/>после перевода на сегодня останется X"]
    G --> H["Face ID"]
    H --> I["send-home/success<br/>число дня уменьшилось на глазах"]
    I --> E

    E --> J["Обычный день<br/>открыл на 4 секунды"]
    J --> K{"Хватает на сегодня?"}
    K -->|Да| L["Закрыл"]
    K -->|Нет, число близко к нулю| M["home/tight<br/>что можно перенести"]
    M --> E

    E --> N["Рамадан<br/>открыл после ифтара, 23:10"]
    N --> O["home/ramadan-night<br/>ночная палитра<br/>садака и закят в контексте<br/>ночные траты в ленте"]
    O --> E

    E --> P["Конец месяца<br/>остаток уходит в накопление"]
    P --> A
